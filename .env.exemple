# LA CONNEXION A LA BASE.
#
# Copie ce fichier en .env pour que l'application lise PostgreSQL au lieu des
# fichiers de demonstration :
#
#   cp .env.exemple .env
#
# SANS CE FICHIER, L'APPLICATION MARCHE QUAND MEME. Elle repart alors sur les
# donnees ecrites en TypeScript dans server/donnees/. C'est voulu : quelqu'un qui
# clone le depot doit pouvoir lancer npm run dev sans installer Docker, et le
# site en ligne chez Netlify n'a pas de base a joindre.
#
# Le mot de passe est "stock" et il est ecrit en clair : c'est une base de
# demonstration qui ne tourne que sur la machine de developpement, avec des
# donnees inventees. Une vraie base ne mettrait jamais ses identifiants dans un
# fichier versionne - c'est pour ca que .env est dans .gitignore et que ce
# fichier-ci s'appelle .env.exemple.

DATABASE_URL=postgres://stock:stock@localhost:5433/stock
